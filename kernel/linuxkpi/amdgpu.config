# Milestone 7 (docs/linux-drivers.md): the amdgpu configuration, not merged into the
# build yet. Appended to nova.config it compiles cleanly; linking still needs the symbols
# listed in the milestone's status section.
CONFIG_DRM=y
CONFIG_DRM_AMDGPU=y
CONFIG_DRM_AMD_DC=y
# CONFIG_DRM_AMDGPU_SI is not set
# CONFIG_DRM_AMDGPU_CIK is not set
# CONFIG_DRM_AMDGPU_USERPTR is not set
# CONFIG_DRM_FBDEV_EMULATION is not set
# CONFIG_HSA_AMD is not set
