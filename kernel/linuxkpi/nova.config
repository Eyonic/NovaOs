# Linux configuration fragment for Nova's Linux driver layer, applied on top of
# `make tinyconfig` by scripts/build-linux.sh. Only the subsystems and drivers Nova runs
# are enabled, and anything that would make the objects depend on Linux runtime machinery
# Nova does not emulate (modules, SMP, code patching, tracing, hardening plugins) is off.

# Base: 64-bit, single CPU, no loadable modules; HZ matches Nova's 1000 Hz timer (pit.rs).
# Linux 7.x has no PREEMPT_NONE on x86, so the objects keep preempt counting; lx_emul
# never requests a reschedule, so preempt_enable() never calls into a scheduler.
CONFIG_64BIT=y
# CONFIG_SMP is not set
# CONFIG_MODULES is not set
CONFIG_HZ_1000=y
CONFIG_PRINTK=y
# CONFIG_BUG is not set

# No runtime code patching or instrumentation: Nova links the objects as they are.
# CONFIG_JUMP_LABEL is not set
# CONFIG_CPU_MITIGATIONS is not set
# CONFIG_STACKPROTECTOR is not set
# CONFIG_FUNCTION_TRACER is not set
# CONFIG_KPROBES is not set
# CONFIG_PARAVIRT is not set
# CONFIG_X86_KERNEL_IBT is not set
# CONFIG_DEBUG_INFO is not set
CONFIG_DEBUG_INFO_NONE=y

# Buses
CONFIG_PCI=y
CONFIG_PCI_MSI=y

# Network devices (Nova's own TCP/IP stack sits on top; no Linux INET stack)
CONFIG_NET=y
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_REALTEK=y
CONFIG_8139CP=y
CONFIG_8139TOO=y
# CONFIG_8139TOO_PIO is not set
CONFIG_MII=y
# The board's network (RTL8168/8125): r8169 on phylib with the Realtek PHY driver
CONFIG_R8169=y
CONFIG_PHYLIB=y
CONFIG_REALTEK_PHY=y

# USB: xHCI host controllers, the USB core, HID (keyboards, mice, gamepads), input core
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_HID_SUPPORT=y
CONFIG_HID=y
CONFIG_USB_HID=y
CONFIG_HID_GENERIC=y
CONFIG_INPUT=y
# sysfs: Linux code (the USB hub driver among it) treats missing sysfs nodes as errors;
# lx_emul accepts every attribute and hands out placeholder nodes (support.c).
CONFIG_SYSFS=y
CONFIG_NET_VENDOR_INTEL=y
CONFIG_E1000E=y

# Make PAGE_OFFSET, VMALLOC_START and VMEMMAP_START variables (page_offset_base, ...)
# instead of constants: lx_emul sets page_offset_base to Nova's direct-map base (Limine's
# HHDM), so __pa()/__va() inside Linux code agree with Nova's memory.rs.
CONFIG_RELOCATABLE=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_RANDOMIZE_MEMORY=y

# GPU: amdgpu (Radeon RX 6000 series and newer) with its display core, on the DRM core
# and TTM. SI/CIK cards, userptr (needs MMU notifiers), fbdev emulation and the KFD
# compute driver are off.
CONFIG_DRM=y
CONFIG_DRM_AMDGPU=y
CONFIG_DRM_AMD_DC=y
# CONFIG_DRM_AMDGPU_SI is not set
# CONFIG_DRM_AMDGPU_CIK is not set
# CONFIG_DRM_AMDGPU_USERPTR is not set
# CONFIG_DRM_FBDEV_EMULATION is not set
# CONFIG_HSA_AMD is not set

# 32-bit programs (Steam's client): CONFIG_COMPAT gives drivers their compat_ioctl
# handlers (DRM's drm_ioc32.c), which Nova calls for i386 programs.
CONFIG_IA32_EMULATION=y
